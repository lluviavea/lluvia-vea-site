# Public site URL — used for absolute SEO / Open-Graph URLs.
# In production, set this to your deployed domain (no trailing slash).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# OpenRouter API key — powers the AI digital twin chat (/api/chat).
# Your local .env uses the lowercase name openrouter_api_key; both work.
OPENROUTER_API_KEY="sk-or-xxxxxx"
